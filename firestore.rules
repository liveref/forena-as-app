rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/as-app-admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/as-app-admins/$(request.auth.uid)).data.active == true;
    }

    match /as-app/items {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /as-app-images/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /as-app-admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
  }
}
